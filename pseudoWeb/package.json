{
  "name": "pseudoweb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "setup": "pnpm install",
    "dev": "pnpm --filter @pseudoweb/web dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @pseudoweb/core build && pnpm --filter @pseudoweb/web typecheck",
    "clean:deps": "rm -rf node_modules packages/*/node_modules"
  }
}
