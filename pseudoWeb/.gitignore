# Ignore repository-local documentation and scratch files in packages
# Core package: ignore textual notes and ARCHITECTURE files
/packages/core/src/**/*.txt
/packages/core/src/**/ARCHITECTURE.md
/packages/core/src/**/descripcion*.txt
/packages/core/src/**/description*.md

# Web package: ignore textual notes, summaries and scratch files
/packages/web/**/**/*.txt
/packages/web/**/resumen.txt
/packages/web/**/descripcion*.txt

# Generic: ignore local note files matching common patterns (only in packages)
/packages/*/**/impl*.txt
/packages/*/**/plan*.txt
